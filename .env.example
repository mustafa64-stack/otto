# Otto Environment Configuration

APP_ENV=sandbox
PORT=8000
HOST=127.0.0.1

# PayPal Sandbox Credentials (Obtain from https://developer.paypal.com/dashboard/)
PAYPAL_CLIENT_ID=your-sandbox-client-id-here
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret-here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Spending Mandate Defaults (USD)
MAX_AUTO_APPROVE_AMOUNT=50.00
QUARANTINE_THRESHOLD_AMOUNT=150.00
HOURLY_VELOCITY_LIMIT=250.00

